# Copy to .env and edit. All values are optional for local development.
# APP_ENV=production refuses to start with the dev SECRET_KEY or a wildcard CORS origin.
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-or-more-random-characters
# Optional: separate signing key for JWTs (defaults to SECRET_KEY)
# JWT_SECRET_KEY=
BCRYPT_LOG_ROUNDS=12
# Default is a local SQLite file. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/gariyangu
DATABASE_URL=sqlite:///gariyangu.db
CORS_ORIGINS=http://localhost:5173
TOKEN_HOURS=72

# Persistent directory for uploaded vehicle photos
UPLOAD_FOLDER=uploads

# Signup email codes. Without SMTP_HOST the code is printed in the server log (development only);
# APP_ENV=production requires SMTP_HOST.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Gari Yangu <no-reply@yourdomain.com>
# SMTP_SSL=0            # 1 = implicit TLS (port 465)
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=30
